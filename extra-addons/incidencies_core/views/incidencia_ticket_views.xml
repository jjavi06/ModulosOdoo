<odoo>
    <data>
        <record id="view_incidencia_ticket_search" model="ir.ui.view">
            <field name="name">incidencia.ticket.search</field>
            <field name="model">incidencia.ticket</field>
            <field name="arch" type="xml">
                <search>
                    <field name="asunto"/>
                    <field name="tipus_id"/>
                    <filter name="filter_rebuda" string="Rebuda" domain="[('state', '=', 'rebuda')]"/>
                    <filter name="filter_en_proces" string="En proces" domain="[('state', '=', 'en_proces')]"/>
                    <filter name="filter_resolta" string="Resolta" domain="[('state', '=', 'resolta')]"/>
                    <filter name="filter_tancada" string="Tancada" domain="[('state', '=', 'tancada')]"/>
                    <group expand="0" string="Agrupar per">
                        <filter name="group_tipus" string="Tipus" context="{'group_by': 'tipus_id'}"/>
                        <filter name="group_state" string="Estat" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="view_incidencia_ticket_list" model="ir.ui.view">
            <field name="name">incidencia.ticket.list</field>
            <field name="model">incidencia.ticket</field>
            <field name="arch" type="xml">
                <list>
                    <field name="asunto"/>
                    <field name="aula_id"/>
                    <field name="tipus_id"/>
                    <field name="user_id"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_incidencia_ticket_form" model="ir.ui.view">
            <field name="name">incidencia.ticket.form</field>
            <field name="model">incidencia.ticket</field>
            <field name="arch" type="xml">
                <form edit="1">
                    <sheet>
                        <group>
                            <field name="asunto"/>
                            <field name="tipus_id"/>
                            <field name="aula_id"/>
                            <field name="user_id"/>
                            <field name="state"/>
                        </group>
                        <notebook>
                            <page string="Descripcio">
                                <field name="mensaje"/>
                            </page>
                            <page string="Tecnic">
                                <field name="comentarios_tecnicos"/>
                            </page>
                            <page string="Foto">
                                <field name="foto" filename="foto_filename" widget="image" class="oe_avatar"/>
                                <field name="foto_filename" invisible="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_incidencia_ticket" model="ir.actions.act_window">
            <field name="name">Incidencies</field>
            <field name="res_model">incidencia.ticket</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_incidencia_ticket_search"/>
        </record>
    </data>
</odoo>
