<odoo>
    <data>
        <record id="view_incidencia_ticket_client_list" model="ir.ui.view">
            <field name="name">incidencia.ticket.client.list</field>
            <field name="model">incidencia.ticket</field>
            <field name="arch" type="xml">
                <list create="1" edit="0" delete="0">
                    <field name="asunto"/>
                    <field name="aula_id"/>
                    <field name="tipus_id"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_incidencia_ticket_client_form" model="ir.ui.view">
            <field name="name">incidencia.ticket.client.form</field>
            <field name="model">incidencia.ticket</field>
            <field name="arch" type="xml">
                <form create="1" edit="0" delete="0">
                    <sheet>
                        <group>
                            <field name="asunto"/>
                            <field name="tipus_id"/>
                            <field name="aula_id"/>
                            <field name="user_id" readonly="1" invisible="1"/>
                        </group>
                        <group>
                            <field name="mensaje"/>
                            <field name="foto" filename="foto_filename" widget="image"/>
                            <field name="foto_filename" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_incidencies_client_ticket" model="ir.actions.act_window">
            <field name="name">Les Meves Incidencies</field>
            <field name="res_model">incidencia.ticket</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('user_id', '=', uid)]</field>
            <field name="context">{'default_user_id': uid}</field>
            <field name="view_id" ref="view_incidencia_ticket_client_list"/>
        </record>
    </data>
</odoo>
